public static class ContextAssembler \{\uc0\u8232     public static string BuildKnowledgeBlock(List<RAGResult> results, int maxChars = 4000) \{\u8232         var sb = new System.Text.StringBuilder();\u8232         sb.AppendLine("<retrieved_knowledge>");\u8232         foreach (var r in results) \{\u8232             var txt = r.text.Replace("\\n", " ");\u8232             if (sb.Length + txt.Length > maxChars) break;\u8232             sb.AppendLine($"<knowledge id=\\"\{r.chunk_id\}\\" doc=\\"\{r.doc_title\}\\">\{txt\}</knowledge>");\u8232         \}\u8232         sb.AppendLine("</retrieved_knowledge>");\u8232         return sb.ToString();\u8232     \}\u8232 \}\
9.4 TurnCoordinator Sketch\
public class TurnCoordinator : MonoBehaviour \{\uc0\u8232     public RAGClient Rag;\u8232     public RealtimeSessionManager Rt;\u8232     public ConversationState State;\u8232     public string UserId = "u-123";\u8232 \u8232     public async void OnUserUtteranceFinal(string transcript) \{\u8232         // classify: do we need retrieval?\u8232         bool needRag = NeedsRetrieval(transcript);\u8232         string knowledgeBlock = string.Empty;\u8232         if (needRag) \{\u8232             var hits = await Rag.QueryAsync(transcript, UserId, topK:5);\u8232             knowledgeBlock = ContextAssembler.BuildKnowledgeBlock(hits);\u8232         \}\u8232 \u8232         // push context + user message to realtime session\u8232         Rt.AddContextItem(knowledgeBlock);      // system or tool item\u8232         Rt.AddUserItem(transcript);             // user message\u8232         Rt.RequestModelResponse();              // send response.create event\u8232     \}\u8232 \u8232     bool NeedsRetrieval(string t) \{\u8232         t = t.ToLowerInvariant();\u8232         if (t.Contains("what is") || t.Contains("how do") || t.Contains("explain") || t.Contains("treehouse")) return true;\u8232         return false; // TODO: ML classifier\u8232     \}\u8232 \}\

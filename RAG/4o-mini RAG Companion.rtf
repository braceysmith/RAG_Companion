\cf0 4.2 Simple Ingestion Script (Python sketch)\
# ingest.py\uc0\u8232 import os, json, uuid, tiktoken\u8232 from pathlib import Path\u8232 from openai import OpenAI  # new python sdk\u8232 from my_chunker import chunk_text\u8232 from my_store import upsert_vectors  # wrapper over pgvector/qdrant\u8232 \u8232 client = OpenAI()\u8232 encoding = tiktoken.get_encoding("cl100k_base")\u8232 \u8232 SRC_DIR = "data/raw"\u8232 \u8232 for path in Path(SRC_DIR).rglob("*.txt"):\u8232     text = Path(path).read_text(encoding="utf-8")\u8232     chunks = chunk_text(text, tokens_per_chunk=600, overlap=80)  # returns [(text,meta),...]\u8232     for i,(chunk_text, meta) in enumerate(chunks):\u8232         meta.update(\{\u8232             "chunk_id": f"\{path.stem\}-\{i\}",\u8232             "source_path": str(path),\u8232         \})\u8232         # embed\u8232         emb = client.embeddings.create(\u8232             model="text-embedding-3-small",\u8232             input=chunk_text\u8232         ).data[0].embedding\u8232         upsert_vectors([(meta["chunk_id"], emb, \{"text": chunk_text, **meta\})])\
In production batch calls; handle rate limits; cache hash(text)
\f3 \uc0\u8594 
\f0 embedding.\

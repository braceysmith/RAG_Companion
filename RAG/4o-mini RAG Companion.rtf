8. Backend Retrieval Service \'96 Minimal FastAPI Example\
This is 
\f1\b just enough
\f0\b0  to stand up a working prototype.\
8.1 Env Setup\
python -m venv venv\uc0\u8232 source venv/bin/activate\u8232 pip install fastapi uvicorn psycopg[binary] pgvector openai tiktoken python-dotenv\
8.2 Table Sketch (pgvector)\
CREATE EXTENSION IF NOT EXISTS vector;\uc0\u8232 CREATE TABLE IF NOT EXISTS rag_chunks (\u8232   chunk_id TEXT PRIMARY KEY,\u8232   embedding VECTOR(1536),\u8232   text TEXT,\u8232   doc_title TEXT,\u8232   section TEXT,\u8232   tags TEXT[],\u8232   user_scope TEXT,\u8232   created_at TIMESTAMPTZ DEFAULT NOW()\u8232 );\u8232 CREATE INDEX ON rag_chunks USING ivfflat (embedding vector_l2_ops) WITH (lists = 100);\
8.3 FastAPI\
# rag_api.py\uc0\u8232 import os\u8232 from typing import List, Optional\u8232 from fastapi import FastAPI\u8232 from pydantic import BaseModel\u8232 import psycopg\u8232 from openai import OpenAI\u8232 \u8232 client = OpenAI()\u8232 app = FastAPI()\u8232 \u8232 class RAGQuery(BaseModel):\u8232     query: str\u8232     top_k: int = 5\u8232     user_id: Optional[str] = None\u8232     filters: Optional[dict] = None  # e.g., \{"user_scope": ["global","u-123"]\}\u8232 \u8232 @app.post("/query")\u8232 async def rag_query(q: RAGQuery):\u8232     # embed query\u8232     emb = client.embeddings.create(model="text-embedding-3-small", input=q.query).data[0].embedding\u8232     # build filter clause\u8232     where = ""\u8232     params = \{"emb": emb\}\u8232     if q.filters and "user_scope" in q.filters:\u8232         where = "WHERE user_scope = ANY(%(scopes)s)"\u8232         params["scopes"] = q.filters["user_scope"]\u8232     sql = f"""\u8232         SELECT chunk_id, text, doc_title, section,\u8232                1 - (embedding <=> %(emb)s::vector) AS score\u8232         FROM rag_chunks\u8232         \{where\}\u8232         ORDER BY embedding <=> %(emb)s::vector\u8232         LIMIT \{q.top_k\}\u8232     """\u8232     rows = []\u8232     async with await psycopg.AsyncConnection.connect(os.getenv("DB_URL")) as conn:\u8232         async with conn.cursor() as cur:\u8232             await cur.execute(sql, params)\u8232             for r in await cur.fetchall():\u8232                 rows.append(\{\u8232                     "chunk_id": r[0],\u8232                     "text": r[1],\u8232                     "doc_title": r[2],\u8232                     "section": r[3],\u8232                     "score": float(r[4])\u8232                 \})\u8232     return \{"results": rows\}\
Run:\
uvicorn rag_api:app --reload --port 8077\
\

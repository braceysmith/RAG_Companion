9.1 Data Models\
[System.Serializable]\uc0\u8232 public class RAGResult \{\u8232     public string chunk_id;\u8232     public string text;\u8232     public string doc_title;\u8232     public string section;\u8232     public float score;\u8232 \}\u8232 \u8232 [System.Serializable]\u8232 public class RAGQueryRequest \{\u8232     public string query;\u8232     public int top_k = 5;\u8232     public RAGFilters filters = new();\u8232 \}\u8232 \u8232 [System.Serializable]\u8232 public class RAGFilters \{\u8232     public string[] user_scope; // \{"global","u-123"\}\u8232 \}\u8232 \u8232 [System.Serializable]\u8232 public class RAGQueryResponse \{\u8232     public List<RAGResult> results;\u8232 \}\
9.2 RAGClient (UnityWebRequest)\
public class RAGClient \{\uc0\u8232     readonly string _baseUrl;\u8232     public RAGClient(string baseUrl) => _baseUrl = baseUrl.TrimEnd('/');\u8232 \u8232     public async Task<List<RAGResult>> QueryAsync(string text, string userId, int topK = 5) \{\u8232         var reqObj = new RAGQueryRequest \{\u8232             query = text,\u8232             top_k = topK,\u8232             filters = new RAGFilters \{ user_scope = new[]\{"global", userId\} \}\u8232         \};\u8232         var json = JsonUtility.ToJson(reqObj);\u8232         using var req = new UnityWebRequest(_baseUrl + "/query", "POST");\u8232         byte[] bodyRaw = System.Text.Encoding.UTF8.GetBytes(json);\u8232         req.uploadHandler = new UploadHandlerRaw(bodyRaw);\u8232         req.downloadHandler = new DownloadHandlerBuffer();\u8232         req.SetRequestHeader("Content-Type", "application/json");\u8232         var op = req.SendWebRequest();\u8232         while(!op.isDone) await Task.Yield();\u8232         if(req.result != UnityWebRequest.Result.Success) \{\u8232             Debug.LogError($"RAG query failed: \{req.error\}");\u8232             return new();\u8232         \}\u8232         var resp = JsonUtility.FromJson<RAGQueryResponse>(req.downloadHandler.text);\u8232         return resp.results ?? new();\u8232     \}\u8232 \}\
